+#    con noindex y sin caché para los archivos de la app. Revisa que estén los archivos de sw.js.
 # 3) Sube por FTP. La cuenta FTP tiene como raíz public_html/web/suvico-app,
 #    por eso server-dir es ./ (no puede tocar otras carpetas del sitio).
 name: Deploy a web.temacy.com/suvico-app
@@ -56,11 +57,17 @@ jobs:
               if [ -f "$d/index.html" ]; then cp -a "$d/." _publicar/; break; fi
             done
           else
-            # Solo la app: docs/, referencia/, pruebas/, servidor-local.js y los .md
