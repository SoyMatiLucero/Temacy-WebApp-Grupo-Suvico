# web.temacy.com/suvico-app: fuera de Google y rutas de SPA.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /suvico-app/
  # Si el archivo o carpeta existe, se sirve tal cual.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Cualquier otra ruta de la app vuelve a index.html.
  RewriteRule ^ index.html [L]
</IfModule>

# Que index.html no quede en caché vieja después de cada deploy.
<FilesMatch "index\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>
