# web.temacy.com/suvico-app: fuera de Google.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# Que la página y el service worker no queden en caché vieja después de cada deploy
# (la app ya guarda su propia copia para abrir sin conexión).
<FilesMatch "(\.html|sw\.js|\.webmanifest)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>

AddType application/manifest+json .webmanifest
